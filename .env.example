PORT=8000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local PostgreSQL fallback when DATABASE_URL is not set.
DB_NAME=createx
DB_USER=createx
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
RANDOM_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:3000,http://localhost:4173
NODE_ENV=development
